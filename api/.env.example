# Copy to .env and fill in. Never commit .env.
#
# Base : npm run db:migrate puis npm run db:seed
# Le seed lit ../movies.json (racine du dépôt) depuis le dossier api.

# MySQL : 3306 = install locale classique ; 3307 = docker-compose.dev.yml / compose racine (mapping hôte)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cinenoir
DB_PASSWORD=cinenoir
DB_NAME=cinenoir

JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# Optional: personalized recommendations (Chat Completions API)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Nombre de films tirés de la table movies pour le classement (20–300, défaut 100)
# RECOMMENDATION_MAX_CANDIDATES=100
